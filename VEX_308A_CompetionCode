void pre_auton()
{
	bStopTasksBetweenModes = true;

	SensorType[Gyro] = sensorNone;
	wait1Msec(1000);
	SensorType[Gyro] = sensorGyro;
	wait1Msec(2000);
	//SensorScale[Gyro] = 260;
}

task autonomous()
{

	bool RightTurn = false;
	bool LeftTurn = false;
	bool motorbrake = false;
	bool Intake = false;
	bool FireCata = false;




	SensorValue[LeftEncoder] = SensorValue[RightEncoder] = 0;

	//Turning Right 90°
	if(RightTurn == true)
	{
		SensorValue[Gyro] = 0;
		motor[LeftMotor1] = motor[LeftMotor2] = 100;
		motor[RightMotor1] = motor[RightMotor2] = -100;
		if(SensorValue[Gyro] == -900)
		{
			motor[LeftMotor1] = motor[LeftMotor2] = -20;
			motor[RightMotor1] = motor[RightMotor2] = 20;
			wait1Msec(250);
			motor[LeftMotor1] = motor[LeftMotor2] = motor[RightMotor1] = motor[RightMotor2] = 0;
		}
		SensorValue[LeftEncoder] = SensorValue[RightEncoder] = 0;
		SensorValue[Gyro] = 0;
		RightTurn = false;
	}
	//Turning Left 90°
	if(LeftTurn == true)
	{
		SensorValue[Gyro] = 0;
		motor[LeftMotor1] = motor[LeftMotor2] = -100;
		motor[RightMotor1] = motor[RightMotor2] = 100;
		if(SensorValue[Gyro] == 900)
		{
			motor[LeftMotor1] = motor[LeftMotor2] = 20;
			motor[RightMotor1] = motor[RightMotor2] = -20;
			wait1Msec(250);
			motor[LeftMotor1] = motor[LeftMotor2] = motor[RightMotor1] = motor[RightMotor2] = 0;
		}
		SensorValue[LeftEncoder] = SensorValue[RightEncoder] = 0;
		SensorValue[Gyro] = 0;
		LeftTurn = false;
	}
	//Braking the motor after every forward movement
	if(motorbrake == true)
	{
		motor[LeftMotor1] = motor[LeftMotor2] = motor[RightMotor1] = motor[RightMotor2] = -20;
		wait1Msec(250);
		motor[LeftMotor1] = motor[LeftMotor2] = motor[RightMotor1] = motor[RightMotor2] = 0;
		motorbrake = false;
	}
	//Intake Code
	if(Intake == true)
	{
		motor[IntakeMotor] = motor[IntakeMotor2] = 120;
		if(SensorValue[SonarBall] < 3)
		{
			motor[IntakeMotor] = motor[IntakeMotor2] = 0;
			Intake = false;
		}
	}
	//Firing Code
	if(FireCata == true)
	{
		motor[CatapultMotor] = 120;
		wait1Msec(1000);
		if(SensorValue(CatapultSwitch) == 1) //Button is touching
		{
			motor[CatapultMotor] = 0; //stop retracting
		}
		else
		{
			if(SensorValue(CatapultSwitch) == 0) //If button not touched,
			{
				motor[CatapultMotor] = 120; //retract catapult!
			}
		}
		//Auto-Reload
		if(SensorValue(CatapultSwitch) == 1) //Button is touching
		{
			motor[CatapultMotor] = 0; //stop retracting
		}
		else
		{
			if(SensorValue(CatapultSwitch) == 0) //If button not touched,
			{
				motor[CatapultMotor] = 120; //retract catapult!
			}
		}
	}






	FireCata = true; //Fire for high flag #1
	//
	motor[LeftMotor1] = motor[LeftMotor2] = motor[RightMotor1] = motor[RightMotor2] = 60; //Moving 40 inches forward for low flag #2
	if(SensorValue[LeftEncoder] == 40 * 90)
	{
		motorbrake = true;
	}
	//

	motor[LeftMotor1] = motor[LeftMotor2] = motor[RightMotor1] = motor[RightMotor2] = -60; //Moving 40 inches backward to return to original position
	if(SensorValue[LeftEncoder] == 0)
	{
		motorbrake = true;
	}
	//

	RightTurn = true;
	//

	motor[LeftMotor1] = motor[LeftMotor2] = motor[RightMotor1] = motor[RightMotor2] = 60; //Moving 48 inches forward to flip Cap #3
	Intake = true; 																																				//Get the ball under Cap #3
	if(SensorValue[LeftEncoder] == 47 * 90)
	{
		motorbrake = true;
	}
	//

	LeftTurn = true;
	//

	FireCata = true; //Fire for high flag #2
	//

	motor[LeftMotor1] = motor[LeftMotor2] = motor[RightMotor1] = motor[RightMotor2] = 60; //Moving 40 inches forward for low flag #3
	if(SensorValue[LeftEncoder] == 40 * 90)
	{
		motorbrake = true;
		SensorValue[LeftEncoder] = 0;
	}
	//

	motor[LeftMotor1] = motor[LeftMotor2] = motor[RightMotor1] = motor[RightMotor2] = -60; //Moving 23.5 inches backward
	if(SensorValue[LeftEncoder] == -23.5 * 90)
	{
		motorbrake = true;
	}
	//

	RightTurn = true;
	//

	motor[IntakeMotor] = motor[IntakeMotor2] = -120; //Reverse Intake for flipping Cap #2
	motor[LeftMotor1] = motor[LeftMotor2] = motor[RightMotor1] = motor[RightMotor2] = 60; //Moving 47 inches forward for Cap #2
	if(SensorValue[LeftEncoder] == 47 * 90)
	{
		motorbrake = true;
		motor[IntakeMotor] = motor[IntakeMotor2] = 0;
	}
	//

	RightTurn = true;
	//

	motor[LeftMotor1] = motor[LeftMotor2] = motor[RightMotor1] = motor[RightMotor2] = 60; //Moving 23.5 inches foward, traveling downward the field
	if(SensorValue[LeftEncoder] == 23.5 * 90)
	{
		motorbrake = true;
	}
	//

	RightTurn = true;
	//

	Intake = true; //get ball under Cap #4
	motor[LeftMotor1] = motor[LeftMotor2] = motor[RightMotor1] = motor[RightMotor2] = 60; //Moving 23.5 inches foward for cap #4
	if(SensorValue[LeftEncoder] == 23.5 * 90)
	{
		motorbrake = true;
		motor[IntakeMotor] = motor[IntakeMotor2] = 0;
	}
	//
	motor[LeftMotor1] = motor[LeftMotor2] = motor[RightMotor1] = motor[RightMotor2] = -60; //Moving 70 inches backward for blue top starting point
	if(SensorValue[LeftEncoder] == -70 * 90)
	{
		motorbrake = true;
	}
	//

	RightTurn = true;
	//

	FireCata = true; // fire for high flag #3
	//

	motor[LeftMotor1] = motor[LeftMotor2] = motor[RightMotor1] = motor[RightMotor2] = 60; //Moving 40 inches forward for low flag #3
	if(SensorValue[LeftEncoder] == 40 * 90)
	{
		motorbrake = true;
		SensorValue[LeftEncoder] = 0;
	}
	//

	motor[LeftMotor1] = motor[LeftMotor2] = motor[RightMotor1] = motor[RightMotor2] = -60; //Moving 63.5 inches backward to align at platforms
	if(SensorValue[LeftEncoder] == -63.5 * 90)
	{
		motorbrake = true;
	}
	//

	RightTurn = true;
	//

	motor[LeftMotor1] = motor[LeftMotor2] = motor[RightMotor1] = motor[RightMotor2] = -120; //move backward for center platform
	wait1Msec(2500);
	motor[LeftMotor1] = motor[LeftMotor2] = motor[RightMotor1] = motor[RightMotor2] = 0; //stop, end programming skill

}



task usercontrol()
{

	bool ReadyFire;
	ReadyFire = false;

	int motorspeedL;
	int motorspeedR;

	while(true)
	{




		if(SensorValue(CatapultSwitch) == 1 && ReadyFire == false)			//Button touched, Catapult fully extended
		{
			motor[CatapultMotor] = 0;
		}
		else         //If button not touched, retract catapult!
		{
			motor[CatapultMotor] = 120;
		}


		if(vexRT[Btn8D] == 1 && ReadyFire == false)			//Catapult is fully extended and the button is pressed = FIRE!!
		{
			motor[CatapultMotor] = 120;
			ReadyFire = true;
		}
		if(vexRT[Btn8D] == 0)
		{
			ReadyFire = false;
		}









		motorspeedL = vexRT[Ch3];
		if(abs(motorspeedL) > 110)
		{
			motorspeedL = sgn(motorspeedL) * 110;
		}

		motorspeedR = vexRT[Ch4];
		if(abs(motorspeedR) > 110)
		{
			motorspeedR = sgn(motorspeedR) * 110;
		}

		motor[LeftMotor1] = motorspeedL + motorspeedR;
		motor[LeftMotor2] = motorspeedL + motorspeedR;
		motor[RightMotor1] = motorspeedL - motorspeedR;
		motor[RightMotor2] = motorspeedL - motorspeedR;




		if(vexRT[Btn6U] == 1)
		{
			motor[IntakeMotor] = motor[IntakeMotor2] = 120;
		}
		else
		{
			if(vexRT[Btn6D] == 1)
			{
				motor[IntakeMotor] = motor[IntakeMotor2] = -120;
			}
			else
			{
				motor[IntakeMotor] = motor[IntakeMotor2] = 0;
			}
		}

	}


}